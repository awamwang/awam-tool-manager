__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv/
venv/
*.egg-info/
dist/
build/

# 临时测试脚本（根目录下的）
/test_*.py
/test_output.txt

# WorkBuddy 的工作数据（记忆、会话等），不进版本库
.workbuddy/

# ---- 运行时数据：程序生成、因运行而异，统一在本机应用数据目录 ----
# 默认 `%LOCALAPPDATA%\.awam-tool-manager`（可用 AWAM_RUNTIME_DIR 覆盖），
# 见 src/runtime_paths.py。data/ 只留人写的声明（tools/）。
#
# 下面两条是**旧位置**：旧版本把它们写在仓库里。新版本启动时会迁移走
# （server.main），但仍在跑的旧实例会继续往旧位置写，所以这里继续忽略，
# 免得工作区又变脏。等所有实例都升级后可以删掉这两行。
/data/backend-tools/
/data/launcher-actions/

# ---- 宿主其他 MCP 进程落到本目录的运行时文件 ----
# WorkBuddy 宿主以本仓库为 CWD 拉起它自己的 MCP 进程，其中 torrent-search-mcp
# （uv 工具）启动即在 CWD 创建 ./authorized_tokens.json（Telegram 会话令牌的
# SHA-256 哈希，可用 TELEGRAM_AUTH_FILE 环境变量改落点）。不是本项目的数据，
# 但会让每次会话恢复后 git status 都变脏——与上面忽略旧位置运行时数据同理由。
/authorized_tokens.json
