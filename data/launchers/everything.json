{
  "schemaVersion": "1.0",
  "id": "everything",
  "name": "Everything",
  "displayName": "Everything 文件搜索",
  "type": "utility",
  "description": "Windows 极速文件搜索工具，毫秒级搜索百万文件",
  "detected": true,
  "installed": true,
  "installPath": "C:\\Program Files\\Everything\\Everything.exe",
  "mcp": {
    "serverName": "everything-mcp",
    "installMethod": "npm",
    "installCommand": "npm i -g everything-mcp",
    "packageName": "everything-mcp",
    "connection": {
      "type": "stdio",
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "everything-mcp"
      ]
    },
    "toolsCatalog": {
      "lastSynced": "now",
      "source": "auto",
      "tools": [
        {
          "name": "everything_search",
          "description": "Search files/folders with Everything. Ultra-fast Windows file search (supports wildcards and regex)",
          "inputSchema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "description": "Everything query (supports wildcards and regex)"
              },
              "max_results": {
                "type": "number",
                "default": 200,
                "description": "Maximum number of results"
              },
              "sort": {
                "type": "string",
                "default": "",
                "description": "Sort key (name, size, date, path, etc.)"
              }
            },
            "required": [
              "query"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        {
          "name": "everything_open",
          "description": "Open specified file/folder with default application (Windows only)",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Absolute path of file or folder to open"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        {
          "name": "everything_glob",
          "description": "Wildcard search based on folder. Example: folder='D:/data', pattern='*.pdf'",
          "inputSchema": {
            "type": "object",
            "properties": {
              "folder": {
                "type": "string",
                "description": "Absolute path of folder to search"
              },
              "pattern": {
                "type": "string",
                "default": "*",
                "description": "Wildcard pattern"
              },
              "max_results": {
                "type": "number",
                "default": 200,
                "description": "Maximum number of results"
              }
            },
            "required": [
              "folder"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        {
          "name": "quick_index_prompt",
          "description": "Find related documents by topic keyword and pattern, generate summary prompt",
          "inputSchema": {
            "type": "object",
            "properties": {
              "topic": {
                "type": "string",
                "description": "Topic keyword to search"
              },
              "pattern": {
                "type": "string",
                "default": "*.pdf",
                "description": "File pattern"
              },
              "max_results": {
                "type": "number",
                "default": 50,
                "description": "Maximum number of results"
              }
            },
            "required": [
              "topic"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        }
      ]
    }
  },
  "sync": {
    "enabled": true,
    "method": "mcp",
    "tool": "everything-mcp",
    "mapFields": {}
  },
  "createdAt": "2026-10-15T13:30:00Z",
  "updatedAt": "2026-10-15T15:30:00Z"
}