    "inputSchema": {
      "type": "object",
      "properties": {
        "tool_id": {
          "type": "string",
          "description": "工具 ID"
        },
        "id": {
          "type": "string",
          "description": "`tool_id` 的别名（与 tool_id 二选一，两者都给以 tool_id 为准）：工具 ID"
