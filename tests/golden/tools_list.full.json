    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
  {
    "name": "launch_tool",
    "description": "取指定工具的启动命令；传 execute=true 可真正执行启动（默认只返回命令，不执行）。必填：tool_id（可写 id）",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tool_id": {
          "type": "string",
          "description": "工具 ID"
        },
        "execute": {
          "type": "boolean",
          "description": "是否真正执行启动（默认 false：只返回命令、不 spawn 进程）"
        },
        "wait": {
          "type": "number",
          "description": "可选，执行后等待早退的观察窗口秒数（默认 5，封顶 30）；窗口内退出即报退出码，超时仍运行则报 running=true"
        },
        "allowDestructive": {
          "type": "boolean",
          "description": "工具被标记为 destructive 时，执行启动需显式传 true"
        },
        "id": {
          "type": "string",
          "description": "`tool_id` 的别名（与 tool_id 二选一，两者都给以 tool_id 为准）：工具 ID"
        }
      },
      "anyOf": [
        {
          "required": [
            "tool_id"
          ]
        },
        {
          "required": [
            "id"
          ]
        }
      ]
    },
    "annotations": {
      "openWorldHint": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
  {
    "name": "list_capabilities",
    "description": "列出某个工具提供的能力：MCP 子工具 / 启动器动作 / 应用的 launch，每条带完整 inputSchema；可按关键词与条数收窄。必填：tool_id（可写 id）",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tool_id": {
          "type": "string",
          "description": "工具 ID（如 everything-search-mcp、quicker、steam）"
        },
        "keyword": {
          "type": "string",
          "description": "可选，按能力名称/描述/元数据过滤"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "description": "可选，最多返回多少条"
        },
        "refresh": {
          "type": "boolean",
          "description": "可选，MCP 工具强制向后端刷新一次能力缓存（默认读盘；启动器清单按自身的陈旧策略自动重扫）"
        },
        "id": {
          "type": "string",
          "description": "`tool_id` 的别名（与 tool_id 二选一，两者都给以 tool_id 为准）：工具 ID（如 everything-search-mcp、quicker、steam）"
        },
        "query": {
          "type": "string",
          "description": "`keyword` 的别名（与 keyword 二选一，两者都给以 keyword 为准）：可选，按能力名称/描述/元数据过滤"
        }
      },
      "anyOf": [
        {
          "required": [
            "tool_id"
          ]
        },
        {
          "required": [
            "id"
          ]
        }
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
  {
    "name": "call_capability",
    "description": "调用某个工具的能力：把 arguments 交给 MCP 子工具 / 启动器动作 / 应用的 launch；默认只预览，execute=true 才产生副作用，destructive 能力还需 allowDestructive=true。必填：tool_id（可写 id）、capability_id",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tool_id": {
          "type": "string",
          "description": "工具 ID（如 everything-search-mcp、quicker、steam）"
        },
        "capability_id": {
          "type": "string",
          "description": "能力 ID（取自 list_capabilities 的 capabilityId；应用的固定能力是 launch）"
        },
        "arguments": {
          "type": "object",
          "description": "能力自己的参数，结构见 list_capabilities 返回的 inputSchema；默认 {}",
          "additionalProperties": true
        },
        "execute": {
          "type": "boolean",
          "description": "可选，是否真的执行；缺省时只读能力自动执行、写/破坏性能力只预览"
        },
        "allowDestructive": {
          "type": "boolean",
          "description": "能力被标记为 destructive 时，执行需显式传 true"
        },
        "wait": {
          "type": "number",
          "description": "可选，启动器动作/应用启动的观察窗口秒数（默认取条目配置）"
        },
        "id": {
          "type": "string",
          "description": "`tool_id` 的别名（与 tool_id 二选一，两者都给以 tool_id 为准）：工具 ID（如 everything-search-mcp、quicker、steam）"
        }
      },
      "required": [
        "capability_id"
      ],
      "anyOf": [
        {
          "required": [
            "tool_id"
          ]
        },
        {
          "required": [
            "id"
          ]
        }
      ]
    },
    "annotations": {
      "openWorldHint": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
