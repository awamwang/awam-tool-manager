[
  {
    "name": "search_tools",
    "description": "搜索已注册的工具，按关键词匹配名称、描述、标签，可按类型、安装状态、发布者筛选。必填：keyword（可写 query）",
    "inputSchema": {
      "type": "object",
      "properties": {
        "keyword": {
          "type": "string",
          "description": "搜索关键词"
        },
        "kind": {
          "type": "string",
          "description": "可选，按工具类型筛选（如 app、mcp、launcher）"
        },
        "status": {
          "type": "string",
          "enum": [
            "installed",
            "not_installed",
            "unknown"
          ],
          "description": "可选，按安装状态精确筛选（条目未写 status 时按 installed 计）"
        },
        "publisher": {
          "type": "string",
          "description": "可选，按发布者筛选（子串匹配、大小写不敏感；条目没写 publisher 一律不命中）"
        },
        "query": {
          "type": "string",
          "description": "`keyword` 的别名（与 keyword 二选一，两者都给以 keyword 为准）：搜索关键词"
        }
      },
      "anyOf": [
        {
          "required": [
            "keyword"
          ]
        },
        {
          "required": [
            "query"
          ]
        }
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
  {
    "name": "list_tools",
    "description": "列出所有已注册的工具，可按类型、安装状态、发布者筛选",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "description": "可选，按工具类型筛选（如 app、mcp、launcher）"
        },
        "status": {
          "type": "string",
          "enum": [
            "installed",
            "not_installed",
            "unknown"
          ],
          "description": "可选，按安装状态精确筛选（条目未写 status 时按 installed 计）"
        },
        "publisher": {
          "type": "string",
          "description": "可选，按发布者筛选（子串匹配、大小写不敏感；条目没写 publisher 一律不命中）"
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
  {
    "name": "get_tool_info",
    "description": "查看工具的详细信息。必填：tool_id（可写 id）",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tool_id": {
          "type": "string",
          "description": "工具 ID，如 everything、everything-search-mcp"
        },
        "id": {
          "type": "string",
          "description": "`tool_id` 的别名（与 tool_id 二选一，两者都给以 tool_id 为准）：工具 ID，如 everything、everything-search-mcp"
        }
      },
      "anyOf": [
        {
          "required": [
            "tool_id"
          ]
        },
        {
          "required": [
