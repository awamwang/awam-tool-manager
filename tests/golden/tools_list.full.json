  },
  {
    "name": "discover_tools",
    "description": "发现本机工具：按声明式候选清单做只读探测（路径存在 / 目录条目数 / 注册表登记值 / 命令是否在 PATH），对照已登记工具给出 installed / not_installed / unknown 结论（默认不执行任何命令）",
    "inputSchema": {
      "type": "object",
      "properties": {
        "run_commands": {
          "type": "boolean",
          "description": "可选，默认 false。true 才真正执行清单里的版本命令取版本号（会 spawn 子进程）；false 只报告命令是否在 PATH 上"
        },
        "status": {
          "type": "string",
          "enum": [
            "installed",
            "not_installed",
            "unknown"
          ],
          "description": "可选，只返回该结论的候选（summary 仍是整份清单的计数）"
        }
      }
    },
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
  {
