  {
    "name": "get_tool_help",
    "description": "取工具的帮助信息（文档链接 / 后端能力清单 / 启动器动作清单）；kind=app 传 run=true 可执行帮助命令并捕获输出。必填：tool_id（可写 id）",
    "inputSchema": {
      "type": "object",
      "properties": {
