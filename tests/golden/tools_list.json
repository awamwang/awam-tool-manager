[
  {
    "name": "search_tools",
    "description": "搜索已注册的工具，按关键词匹配名称、描述、标签，可按类型、安装状态、发布者筛选",
    "inputSchema": {
      "type": "object",
      "properties": {
        "keyword": {
          "type": "string",
          "description": "搜索关键词"
        },
        "kind": {
          "type": "string",
          "description": "可选，按工具类型筛选（如 app、mcp、launcher）"
        },
        "status": {
          "type": "string",
          "enum": [
            "installed",
            "not_installed",
            "unknown"
          ],
          "description": "可选，按安装状态精确筛选（条目未写 status 时按 installed 计）"
        },
        "publisher": {
          "type": "string",
          "description": "可选，按发布者筛选（子串匹配、大小写不敏感；条目没写 publisher 一律不命中）"
        }
      },
      "required": [
        "keyword"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
  {
    "name": "list_tools",
    "description": "列出所有已注册的工具，可按类型、安装状态、发布者筛选",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "description": "可选，按工具类型筛选（如 app、mcp、launcher）"
        },
        "status": {
          "type": "string",
          "enum": [
            "installed",
            "not_installed",
            "unknown"
          ],
          "description": "可选，按安装状态精确筛选（条目未写 status 时按 installed 计）"
        },
        "publisher": {
          "type": "string",
          "description": "可选，按发布者筛选（子串匹配、大小写不敏感；条目没写 publisher 一律不命中）"
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
  {
    "name": "get_tool_info",
    "description": "查看工具的详细信息",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tool_id": {
          "type": "string",
          "description": "工具 ID，如 everything、everything-search-mcp"
        }
      },
      "required": [
        "tool_id"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
  {
    "name": "launch_tool",
    "description": "取指定工具的启动命令；传 execute=true 可真正执行启动（默认只返回命令，不执行）",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tool_id": {
          "type": "string",
          "description": "工具 ID"
        },
        "execute": {
          "type": "boolean",
          "description": "是否真正执行启动（默认 false：只返回命令、不 spawn 进程）"
        },
        "wait": {
          "type": "number",
          "description": "可选，执行后等待早退的观察窗口秒数（默认 5，封顶 30）；窗口内退出即报退出码，超时仍运行则报 running=true"
        },
        "allowDestructive": {
          "type": "boolean",
          "description": "工具被标记为 destructive 时，执行启动需显式传 true"
        }
      },
      "required": [
        "tool_id"
      ]
    },
    "annotations": {
      "openWorldHint": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
  {
    "name": "call_backend_tool",
    "description": "路由调用：转发请求到指定 MCP 工具的后端 Server 执行具体操作",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tool_id": {
          "type": "string",
          "description": "MCP 工具 ID（如 everything-search-mcp）"
        },
        "tool_name": {
          "type": "string",
          "description": "要调用的后端工具名"
        },
        "arguments": {
          "type": "object",
          "description": "调用参数"
        },
        "allowDestructive": {
          "type": "boolean",
          "description": "目标工具被标记为 destructive 时，需显式传 true 才会转发"
        }
      },
      "required": [
        "tool_id",
        "tool_name"
      ]
    },
    "annotations": {
      "openWorldHint": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
  {
    "name": "list_backend_tools",
