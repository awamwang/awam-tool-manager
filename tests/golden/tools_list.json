[
  {
    "name": "search_tools",
    "description": "搜索已注册的工具，按关键词匹配名称、描述、标签，可按类型、安装状态、发布者筛选",
    "inputSchema": {
      "type": "object",
      "properties": {
        "keyword": {
          "type": "string",
          "description": "搜索关键词"
        },
        "kind": {
          "type": "string",
          "description": "可选，按工具类型筛选（如 app、mcp、launcher）"
        },
        "status": {
          "type": "string",
          "enum": [
            "installed",
            "not_installed",
            "unknown"
          ],
          "description": "可选，按安装状态精确筛选（条目未写 status 时按 installed 计）"
        },
        "publisher": {
          "type": "string",
          "description": "可选，按发布者筛选（子串匹配、大小写不敏感；条目没写 publisher 一律不命中）"
        },
        "query": {
          "type": "string",
          "description": "`keyword` 的别名（与 keyword 二选一，两者都给以 keyword 为准）：搜索关键词"
        },
        "q": {
          "type": "string",
          "description": "`keyword` 的别名（与 keyword 二选一，两者都给以 keyword 为准）：搜索关键词"
        },
        "text": {
          "type": "string",
          "description": "`keyword` 的别名（与 keyword 二选一，两者都给以 keyword 为准）：搜索关键词"
        }
      },
      "anyOf": [
        {
          "required": [
            "keyword"
          ]
        },
        {
          "required": [
            "query"
          ]
        },
        {
          "required": [
            "q"
          ]
        },
        {
          "required": [
            "text"
          ]
        }
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
