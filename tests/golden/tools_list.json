  {
    "name": "sync_launcher_actions",
    "description": "手动同步启动器的动作清单（从启动器本地数据扫描，Quicker 的动作名依赖其缓存，可能只拿到 ID）",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tool_id": {
          "type": "string",
          "description": "启动器工具 ID"
        }
      },
      "required": [
        "tool_id"
      ]
    },
    "annotations": {
      "idempotentHint": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
  {
    "name": "list_launcher_actions",
    "description": "列出/搜索启动器（如 Quicker）的动作：按名称、描述、所属程序或 ID 关键词过滤",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tool_id": {
          "type": "string",
          "description": "启动器工具 ID"
        },
        "keyword": {
          "type": "string",
          "description": "可选，按名称/描述/所属程序/ID 过滤"
        },
        "limit": {
          "type": "integer",
          "description": "可选，最多返回多少条"
        },
        "refresh": {
          "type": "boolean",
          "description": "可选，强制重新扫描启动器本地数据（默认读缓存，缓存超过 5 分钟会自动重扫）"
        }
      },
      "required": [
        "tool_id"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
  {
    "name": "run_launcher_action",
    "description": "调用启动器的动作（如执行一个 Quicker 动作），可传参并等待返回结果",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tool_id": {
          "type": "string",
          "description": "启动器工具 ID"
        },
        "action_id": {
          "type": "string",
          "description": "动作 ID（推荐：稳定不变；二选一，与 action_name 至少给一个）"
        },
        "action_name": {
          "type": "string",
          "description": "动作名称（Quicker 要求名称不重复且不含空格）"
        },
        "param": {
          "type": "string",
          "description": "可选，传给动作的参数（Quicker 用 ? 分隔符，不支持换行）"
        },
        "wait": {
          "type": "number",
          "description": "可选，最长等待秒数（默认取 launcher.timeout，缺省 20）"
        },
        "allowDestructive": {
          "type": "boolean",
          "description": "启动器被标记为 destructive 时，需显式传 true 才会执行"
        }
      },
      "required": [
        "tool_id"
      ]
    },
    "annotations": {
      "openWorldHint": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
  {
    "name": "get_tool_help",
    "description": "取工具的帮助信息（文档链接 / 后端能力清单 / 启动器动作清单）；kind=app 传 run=true 可执行帮助命令并捕获输出",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tool_id": {
          "type": "string",
          "description": "工具 ID"
        },
        "run": {
          "type": "boolean",
          "description": "是否真的执行帮助命令（默认 false：只返回文档链接、能力清单与命令预览，不 spawn）"
        },
        "timeout": {
          "type": "number",
          "description": "可选，执行帮助命令的超时秒数（覆盖条目 help.timeout；默认 5，封顶 30）"
        },
        "allowDestructive": {
          "type": "boolean",
          "description": "工具被标记为 destructive 时，执行帮助命令需显式传 true"
        }
      },
      "required": [
        "tool_id"
      ]
    },
    "annotations": {
      "openWorldHint": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
  {
    "name": "get_usage_stats",
    "description": "查询工具调用使用统计：按天、按对外工具、按目标 tool_id 聚合调用量、成功率与耗时（默认最近 7 天）",
    "inputSchema": {
      "type": "object",
      "properties": {
        "days": {
          "type": "integer",
          "description": "可选，统计窗口天数（按日历日、含今天；默认 7，越界收敛到 1~365）",
          "minimum": 1,
          "maximum": 365
        },
        "tool_id": {
          "type": "string",
          "description": "可选，只看某个登记工具的调用（与调用记录里的 target 精确匹配）"
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
  {
    "name": "discover_tools",
    "description": "发现本机工具：按声明式候选清单做只读探测（路径存在 / 目录条目数 / 注册表登记值 / 命令是否在 PATH），对照已登记工具给出 installed / not_installed / unknown 结论（默认不执行任何命令）",
    "inputSchema": {
      "type": "object",
      "properties": {
        "run_commands": {
          "type": "boolean",
          "description": "可选，默认 false。true 才真正执行清单里的版本命令取版本号（会 spawn 子进程）；false 只报告命令是否在 PATH 上"
        },
        "status": {
          "type": "string",
          "enum": [
            "installed",
            "not_installed",
            "unknown"
          ],
          "description": "可选，只返回该结论的候选（summary 仍是整份清单的计数）"
        }
      }
    },
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  }
]