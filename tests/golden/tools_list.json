        {
          "required": [
            "tool_id"
          ]
        },
        {
          "required": [
            "id"
          ]
        },
        {
          "required": [
            "toolId"
          ]
        },
        {
          "required": [
            "name"
          ]
        }
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    },
    "outputSchema": {
