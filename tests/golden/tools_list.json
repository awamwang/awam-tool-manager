  {
    "name": "launch_tool",
    "description": "取指定工具的启动命令；传 execute=true 可真正执行启动（默认只返回命令，不执行）",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tool_id": {
          "type": "string",
          "description": "工具 ID"
        },
        "execute": {
          "type": "boolean",
          "description": "是否真正执行启动（默认 false：只返回命令、不 spawn 进程）"
        },
        "wait": {
          "type": "number",
          "description": "可选，执行后等待早退的观察窗口秒数（默认 5，封顶 30）；窗口内退出即报退出码，超时仍运行则报 running=true"
        },
        "allowDestructive": {
          "type": "boolean",
          "description": "工具被标记为 destructive 时，执行启动需显式传 true"
        },
        "id": {
          "type": "string",
          "description": "`tool_id` 的别名（与 tool_id 二选一，两者都给以 tool_id 为准）：工具 ID"
        },
        "toolId": {
          "type": "string",
          "description": "`tool_id` 的别名（与 tool_id 二选一，两者都给以 tool_id 为准）：工具 ID"
        },
        "name": {
          "type": "string",
          "description": "`tool_id` 的别名（与 tool_id 二选一，两者都给以 tool_id 为准）：工具 ID"
        }
      },
      "anyOf": [
        {
          "required": [
            "tool_id"
          ]
        },
        {
          "required": [
            "id"
          ]
        },
        {
          "required": [
            "toolId"
          ]
        },
        {
          "required": [
            "name"
          ]
        }
      ]
    },
    "annotations": {
      "openWorldHint": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
  {
    "name": "call_backend_tool",
    "description": "路由调用：转发请求到指定 MCP 工具的后端 Server 执行具体操作",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tool_id": {
          "type": "string",
          "description": "MCP 工具 ID（如 everything-search-mcp）"
        },
        "tool_name": {
          "type": "string",
          "description": "要调用的后端工具名"
        },
        "arguments": {
          "type": "object",
          "description": "调用参数"
        },
        "allowDestructive": {
          "type": "boolean",
          "description": "目标工具被标记为 destructive 时，需显式传 true 才会转发"
        },
        "toolId": {
          "type": "string",
          "description": "`tool_id` 的别名（与 tool_id 二选一，两者都给以 tool_id 为准）：MCP 工具 ID（如 everything-search-mcp）"
        },
        "name": {
          "type": "string",
          "description": "`tool_name` 的别名（与 tool_name 二选一，两者都给以 tool_name 为准）：要调用的后端工具名"
        },
        "backend_tool_name": {
          "type": "string",
          "description": "`tool_name` 的别名（与 tool_name 二选一，两者都给以 tool_name 为准）：要调用的后端工具名"
        },
        "sub_tool_name": {
          "type": "string",
          "description": "`tool_name` 的别名（与 tool_name 二选一，两者都给以 tool_name 为准）：要调用的后端工具名"
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "tool_id"
              ]
            },
            {
              "required": [
                "toolId"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "tool_name"
              ]
            },
            {
              "required": [
                "name"
              ]
            },
            {
              "required": [
                "backend_tool_name"
              ]
            },
            {
              "required": [
                "sub_tool_name"
              ]
            }
          ]
        }
      ]
    },
    "annotations": {
      "openWorldHint": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
