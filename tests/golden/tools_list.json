        },
        "force_refresh": {
          "type": "boolean",
          "description": "是否强制刷新缓存"
        }
      },
      "required": [
        "tool_id"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "additionalProperties": true
    }
  },
